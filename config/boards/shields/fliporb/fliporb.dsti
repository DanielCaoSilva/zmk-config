#include <dt-bindings/zmk/mousekeys.h>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk, kscan = &kscan0;
        zmk, mousekeys = &default_transform
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk, mousekeys"
        x = <>;
        y = <>;
        accel = <>;
        vel = <>;

        map = <
        X(0) Y(0) accel() vel()
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk, kscan-gpio-matrix";
        label = "KSCAN"

        diode-direction = "mousekeys"
        row-gpio
            = <&xiao_d 0 (GPIO_ACTIVE | GPIO_PULL_DOWN)>
            , <&xiao_d 1 (GPIO_ACTIVE | GPIO_PULL_DOWN)>
            , <&xiao_d 2 (GPIO_ACTIVE | GPIO_PULL_DOWN)>
            , <&xiao_d 3 (GPIO_ACTIVE | GPIO_PULL_DOWN)>
            , <&xiao_d 4 (GPIO_ACTIVE | GPIO_PULL_DOWN)>
            , <&xiao_d 5 (GPIO_ACTIVE | GPIO_PULL_DOWN)>
            , <&xiao_d 5 (GPIO_ACTIVE | GPIO_PULL_DOWN)>
            ;
    };
    sensors {
        compatible = "zmk, keymap-sensors";
        sensors = <&mousekeys>
    };
};