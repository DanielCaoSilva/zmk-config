#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>



#define Undo   LC(Z)
#define Cut    LC(X)
#define Copy   LC(C)
#define Paste  LC(V)
#define Redo   LC(Y)

&mmv {
    time-to-max-speed-ms = <850>;
    acceleration-exponent=<1>;
};

&mwh {
    time-to-max-speed-ms = <1500>;
    acceleration-exponent=<1>;
};

&mt {
    tapping-term-ms = <200>;
};

/{
    macros {
        strong: strong {
            compatible = "zmk,behavior-macro";
            label = "new_macro";
            #binding-cells = <0>;
            bindings = <
&kp N1 &kp E &kp Q &kp U &kp A &kp L &kp S 
&kp N0 
&kp P &kp O &kp I &kp N &kp T 
&kp N9 
&kp R &kp E &kp P &kp E &kp A &kp T &kp I &kp N &kp G
&kp P &kp A &kp S &kp S &kp W &kp O &kp R &kp D
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer_outer {
            if-layers = <1 2>;
            then-layer = <5>;
        };
        tri_layer_inner {
                if-layers = <3 4>;
                then-layer = <6>;
        };
        tri_layer_left {
            if-layers = <3 1>;
            then-layer = <7>;
        };
        tri_layer_right {
            if-layers = <2 4>;
            then-layer = <8>;
        };
    };

        keymap {
                compatible = "zmk,keymap";
                default_layer {
                        bindings = <
&kp  TAB      &kp  Q        &kp  W        &kp  E        &kp  R        &kp  T                                                  &kp Y     &kp U     &kp I        &kp O      &kp P        &kp LBKT
&kp  LCTRL    &kp  A        &kp  S        &kp  D        &kp  F        &kp  G                                                  &kp H     &kp J     &kp K        &kp L      &kp SEMI     &kp SQT
&kp  LSHFT    &kp  Z        &kp  X        &kp  C        &kp  V        &kp  B    &kp  ESC                           &kp MINUS  &kp N     &kp M     &kp COMMA    &kp DOT    &kp FSLH     &kp RBKT
                                                        &kp  LGUI     &mo 3     &mo 1    &kp  RET       &kp SPACE  &mo 2      &mo 4      &kp CAPS
                        >;
                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
                };

                left_layer {
                        bindings = <
&kp  TAB     &kp  LC(Q)  &kp LC(W)     &kp LC(E)    &kp LC(R)     &kp LC(T)                                                        &kp   N6      &kp   N7        &kp   N8        &kp   N9        &kp   N0    &kp EQUAL
&kp  LCTRL   &kp  LC(A)  &kp LC(S)     &kp DEL      &kp LC(GRAVE) &kp C_VOL_UP                                                     &kp   PG_UP   &kp  LEFT       &kp   DOWN      &kp   RIGHT     &kp BSPC    &kp BSLH
&kp  LSHIFT  &kp  LC(Z)  &kp LC(X)     &kp LC(C)    &kp LC(V)     &kp C_VOL_DN  &kp Undo                             &kp  Redo     &kp  PG_DN    &kp  LS(MINUS)  &kp   LS(EQUAL) &kp  LBRC       &kp RBRC    &kp RCTRL
                                                    &trans        &trans        &trans        &trans      &trans     &trans        &trans        &trans 
                        >;
                        sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
                };

                right_layer {
                        bindings = <
&kp  ESC     &kp N1    &kp   N2      &kp   N3     &kp   N4      &kp   N5                                                               &kp  LA(TAB) &kp  HOME       &kp   UP        &kp   END       &kp MINUS   &kp EQUAL
&kp  LCTRL   &kp LC(A) &kp LC(S)     &kp DEL      &kp LC(GRAVE) &kp C_VOL_UP                                                           &kp  PG_UP   &kp  LEFT       &kp   DOWN      &kp   RIGHT     &kp BSPC    &kp BSLH
&kp  LSHIFT  &kp LC(Z) &kp LC(X)     &kp LC(C)    &kp LC(V)     &kp C_VOL_DN        &kp Undo                             &kp  Redo     &kp  PG_DN   &kp  LS(MINUS)  &kp   LS(EQUAL) &kp  LBRC       &kp RBRC    &kp RCTRL
                                                    &trans        &trans              &trans        &trans      &trans     &trans        &trans       &trans 
                        >;
                        sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
                };

                sym_layer {
                        bindings = <
&kp  INS      &kp  EXCL     &kp  AT       &kp  HASH     &kp  DOLLAR   &kp  PERCENT                                                                   &kp  CARET    &kp  AMPS     &kp  ASTRK    &kp  LPAR     &kp  RPAR     &kp DEL
&none         &kp  BSLH     &kp  MINUS    &kp  EQUAL    &kp  LBKT     &kp  RBKT                                                                      &kp  HOME     &kp  RSHFT    &kp  RCTRL    &kp  LALT     &kp  RGUI     &kp END
&trans        &kp  PIPE     &kp  UNDER    &kp  PLUS     &kp  LBRC     &kp  RBRC     &sk  RALT                                          &kp K_APP     &kp  C_MUTE   &kp  C_VOL_DN &kp  C_VOL_UP &kp  C_PP     &none         &kp RCTRL
                                                        &trans        &trans        &trans       &trans                   &trans       &trans        &trans        &trans
                        >;	
                        sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
                };

                adj_layer {
                        bindings = <
&none         &trans        &trans        &trans        &none         &none                                                                             &none             &kp   F11          &kp   F12     &kp PRINTSCREEN    &bt BT_PRV         &bt BT_NXT
&sys_reset    &bt  BT_SEL 0 &bt  BT_SEL 1 &bt  BT_SEL 2 &bt  BT_SEL 3 &bt  BT_SEL 4                                                                     &none             &none              &none         &ext_power EP_OFF  &ext_power EP_ON   &bt BT_CLR
&none         &kp  LGUI     &kp  LALT     &kp  LCTRL    &kp LSHIFT    &none         &bt BT_CLR                                         &none            &none             &none              &out  OUT_USB &out  OUT_BLE      &sys_reset         &bootloader
                                                        &trans        &trans        &trans        &trans                 &trans        &trans           &trans            &trans 
                        >;
                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
                };
                outer_layer {
                        bindings = <
&kp  TAB     &kp  LC(Q)  &kp LC(W)     &kp LC(E)    &kp LC(R)     &kp LC(T)                                                        &kp   N6      &kp   N7        &kp   N8        &kp   N9        &kp   N0    &kp EQUAL
&kp  LCTRL   &kp  LC(A)  &kp LC(S)     &kp DEL      &kp LC(GRAVE) &kp C_VOL_UP                                                     &kp   PG_UP   &kp  LEFT       &kp   DOWN      &kp   RIGHT     &kp BSPC    &kp BSLH
&kp  LSHIFT  &kp  LC(Z)  &kp LC(X)     &kp LC(C)    &kp LC(V)     &kp C_VOL_DN  &kp Undo                             &kp  Redo     &kp  PG_DN    &kp  LS(MINUS)  &kp   LS(EQUAL) &kp  LBRC       &kp RBRC    &kp RCTRL
                                                    &trans        &trans        &trans        &trans      &trans     &trans        &trans        &trans 
                        >;
                        sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
                };
                inner_layer {
                        bindings = <
&kp  ESC     &kp   N1    &kp   N2      &kp   N3     &kp   N4      &kp   N5                                                               &kp  LA(TAB) &kp  HOME       &kp   UP        &kp   END       &kp MINUS   &kp EQUAL
&kp  LCTRL   &kp  LC(A)  &kp LC(S)     &kp DEL      &kp LC(GRAVE) &kp C_VOL_UP                                                           &kp  PG_UP   &kp  LEFT       &kp   DOWN      &kp   RIGHT     &kp BSPC    &kp BSLH
&kp  LSHIFT  &kp LC(Z)   &kp LC(X)     &kp LC(C)    &kp LC(V)     &kp C_VOL_DN        &kp Undo                             &kp  Redo     &kp  PG_DN   &kp  LS(MINUS)  &kp   LS(EQUAL) &kp  LBRC       &kp RBRC    &kp RCTRL
                                                    &trans        &trans              &trans        &trans      &trans     &trans        &trans       &trans 
                        >;
                        sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
                };
                double_left_layer {
                        bindings = <
&kp  INS      &kp  EXCL     &kp  AT       &kp  HASH     &kp  DOLLAR   &kp  PERCENT                                                                   &kp  CARET    &kp  AMPS     &kp  ASTRK    &kp  LPAR     &kp  RPAR     &kp DEL
&none         &kp  BSLH     &kp  MINUS    &kp  EQUAL    &kp  LBKT     &kp  RBKT                                                                      &kp  HOME     &kp  RSHFT    &kp  RCTRL    &kp  LALT     &kp  RGUI     &kp END
&trans        &kp  PIPE     &kp  UNDER    &kp  PLUS     &kp  LBRC     &kp  RBRC     &sk  RALT                                          &kp K_APP     &kp  C_MUTE   &kp  C_VOL_DN &kp  C_VOL_UP &kp  C_PP     &none         &kp RCTRL
                                                        &trans        &trans        &trans       &trans                   &trans       &trans        &trans        &trans
                        >;	
                        sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
                };
                double_right_layer {
                        bindings = <
&none         &trans        &trans        &trans        &none         &none                                                                             &none             &kp   F11          &kp   F12     &kp PRINTSCREEN    &bt BT_PRV         &bt BT_NXT
&sys_reset    &bt  BT_SEL 0 &bt  BT_SEL 1 &bt  BT_SEL 2 &bt  BT_SEL 3 &bt  BT_SEL 4                                                                     &none             &none              &none         &ext_power EP_OFF  &ext_power EP_ON   &bt BT_CLR
&none         &kp  LGUI     &kp  LALT     &kp  LCTRL    &kp LSHIFT    &none         &bt BT_CLR                                         &none            &none             &none              &out  OUT_USB &out  OUT_BLE      &sys_reset         &bootloader
                                                        &trans        &trans        &trans        &trans                 &trans        &trans           &trans            &trans 
                        >;
                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
                };                
        };
};