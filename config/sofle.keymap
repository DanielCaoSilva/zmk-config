#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "Base";
            bindings = <
&kp ESC   &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                      &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &kp BSPC
&kp TAB   &kp Q  &kp W    &kp E    &kp R     &kp T                       &kp Y  &kp U     &kp I     &kp O    &kp P    &kp LBKT
&kp LCTRL &kp A  &kp S    &kp D    &kp F     &kp G                       &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B  &kp C_MUTE &none     &kp N  &kp M     &kp COMMA &kp DOT  &kp FSLH &kp RBKT
                 &kp LGUI &kp LALT &kp LCTRL &mo 1  &kp RET    &kp SPACE &mo 2  &mo 3     &kp MINUS &kp EQUAL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        left_layer {
            label = "Left";
            bindings = <
&bt GRAVE       &bt BT_SEL 1    &bt BT_SEL 0  &bt BT_PRV    &bt BT_NXT    &bt BT_CLR                        &trans          &trans    &trans    &trans    &trans    &kp DEL

&trans          &kp INS         &kp PSCRN     &kp K_CMENU   &trans        &trans                            &kp PAUSE_BREAK &kp HOME  &kp UP    &kp END   &kp N0    &trans

&kp CAPS        &kp K_UNDO    &kp C_PREV    &kp C_NEXT   &kp C_VOL_UP  &kp K_COPY                           &kp CARET        &kp LEFT   &kp DOWN  &kp RIGHT &kp RPAR  &kp BSLH

&kp LEFT_SHIFT  &kp K_CUT     &kp K_MUTE    &kp C_PAUSE  &kp C_VOL_DN  &kp K_PASTE  &trans  &trans          &trans           &kp MINUS  &kp EQUAL &kp LBRC  &kp RBRC  &trans
                                &trans        &trans        &trans         &trans      &kp LEFT_WIN &trans   &trans          &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        right_layer {
            label = "Right";
            bindings = <
&kp F12         &kp F1          &kp F2          &kp F3         &kp F4         &kp F5                    &kp F6          &kp F7      &kp F8      &kp F9      &kp F10   &kp F11
&kp GRAVE       &kp N1          &kp N2          &kp N3         &kp N4         &kp N5                    &kp PAUSE_BREAK &kp HOME    &kp UP      &kp END     &kp N0    &trans
&kp LCTRL       &kp C_PREV      &kp C_NEXT      &kp PAGE_UP    &kp C_VOL_UP   &kp F6                    &trans          &kp LEFT    &kp DOWN    &kp RIGHT   &trans    &kp BSLH
&kp LSHFT       &kp C_STOP      &kp C_PAUSE     &kp PAGE_DOWN  &kp C_VOL_DN   &kp F12  &trans  &trans   &kp KP_PLUS     &kp MINUS   &kp EQUAL   &kp KP_PLUS &kp LBRC  &kp RBRC
                                &trans          &trans         &trans         &trans   &trans  &trans   &trans          &trans      &trans      &bootloader
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        game_layer {
            label = "Game";
            bindings = <
&kp ESC         &kp NUMBER_5    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4                     &kp F1            &kp F2           &kp F3          &kp F4            &kp F5  &kp F6
&kp T           &kp TAB         &kp Q         &kp W         &kp E         &kp R                            &trans            &mwh SCROLL_LEFT &mmv MOVE_UP    &mwh SCROLL_RIGHT &trans  &trans
&kp G           &kp CAPSLOCK    &kp A         &kp S         &kp D         &kp F                            &mwh SCROLL_UP    &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT   &trans  &trans
&kp LCTRL       &kp LSHFT       &kp Z         &kp X         &kp C         &kp V        &trans    &trans    &mwh SCROLL_DOWN  &trans           &trans          &trans            &trans  &trans
                                &kp LEFT_ALT  &kp LEFT_WIN  &tog 3        &kp B        &kp SPACE &mkp LCLK &mkp RCLK         &trans           &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
