#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>



&mmv {
    time-to-max-speed-ms = <850>;
    acceleration-exponent=<1>;
};

&mwh {
    time-to-max-speed-ms = <2000>;
    acceleration-exponent=<1>;
};

/{
    macros {
        strong: strong {
            compatible = "zmk,behavior-macro";
            label = "new_macro";
            #binding-cells = <0>;
            bindings = <
&kp N1 &kp E &kp Q &kp U &kp A &kp L &kp S 
&kp N0 
&kp P &kp O &kp I &kp N &kp T 
&kp N9 
&kp R &kp E &kp P &kp E &kp A &kp T &kp I &kp N &kp G
            >;
        };
    };


    keymap {
        compatible = "zmk,keymap";
        base_layer {
            label = "Base";
            bindings = <
&kp ESC     &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                                                            &kp N6    &kp N7     &kp N8     &kp N9   &kp N0   &kp BSPC
&kp TAB     &kp Q   &kp W   &kp E     &kp R     &kp T                                                             &kp Y     &kp U      &kp I      &kp O    &kp P    &kp LBKT
&kp LCTRL   &kp A   &kp S   &kp D     &kp F     &kp G                                                             &kp H     &kp J      &kp K      &kp L    &kp SEMI &kp SQT
&kp LSHFT   &kp Z   &kp X   &kp C     &kp V     &kp B                              &tog 3   &kp MINUS             &kp N     &kp M      &kp COMMA  &kp DOT  &kp FSLH &kp RBKT
                            &kp LGUI  &kp LALT  &mo 1                              &kp RET  &kp SPACE             &mo 2     &kp EQUAL  &tog 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        left_layer {
            label = "Left";
            bindings = <
&kp F12    &kp F1        &kp F2        &kp F3       &kp F4        &kp F5                                          &kp LS(N6)       &kp LS(N7) &kp LS(N8) &kp LS(N9) &kp LS(N0) &kp DEL
&kp TAB    &kp K_MUTE    &kp C_PREV    &kp C_NEXT   &kp C_STOP    &kp C_VOL_UP                                    &kp PAUSE_BREAK  &kp HOME   &kp UP     &kp END    &kp MINUS  &kp EQUAL
&kp CAPS   &kp LC(A)     &kp LC(S)     &kp DEL      &kp GRAVE     &kp GRAVE                                       &kp BSPC         &kp LEFT   &kp DOWN   &kp RIGHT  &kp BSPC   &kp BSLH
&kp LSHFT  &kp LC(Z)     &kp LC(X)     &kp LC(C)    &kp LC(V)     &kp C_VOL_DN      &kp LGUI   &strong            &trans           &kp MINUS  &kp EQUAL  &kp LBRC   &kp RBRC   &trans
                                       &trans       &trans        &trans            &trans     &trans             &trans           &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        right_layer {
            label = "Right";
            bindings = <
&kp F12     &kp RS(N1)  &kp RS(N2)    &kp RS(N3)     &kp RS(N4)     &kp RS(N5)                                    &kp F6          &kp F7      &kp F8      &kp F9       &kp F10   &kp F11
&kp GRAVE   &kp K_MUTE  &kp C_PREV    &kp C_NEXT     &kp C_STOP     &kp C_VOL_UP                                  &strong         &kp HOME    &kp UP      &kp END      &kp MINUS &kp EQUAL
&kp LCTRL   &kp LC(A)   &kp LC(S)     &kp DEL        &kp GRAVE      &kp GRAVE                                     &tog 3          &kp LEFT    &kp DOWN    &kp RIGHT    &kp BSPC  &kp BSLH
&kp LSHFT   &kp LC(Z)   &kp LC(X)     &kp LC(C)      &kp LC(V)      &kp C_VOL_DN      &trans  &trans              &kp KP_PLUS     &kp MINUS   &kp EQUAL   &kp KP_PLUS  &kp LBRC  &kp RBRC
                                      &trans         &trans         &trans            &trans  &trans              &trans          &trans      &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        game_layer {
            label = "Game";
            bindings = <
&kp ESC    &kp N5     &kp N1    &kp N2        &kp N3        &kp N4                                                &kp F1            &kp F2                 &kp F3                &kp F4              &kp F5      &kp F6
&kp T      &kp TAB    &kp Q     &kp W         &kp E         &kp R                                                 &mwh SCROLL_UP    &mwh SCROLL_LEFT       &mmv MOVE_VERT(-3000) &mwh SCROLL_RIGHT   &bt BT_PRV  &bt BT_NXT
&kp G      &kp CAPS   &kp A     &kp S         &kp D         &kp F                                                 &tog 3            &mmv MOVE_HOR(-3000)   &mmv MOVE_VERT(3000)  &mmv MOVE_HOR(3000) &trans      &bt BT_CLR
&kp LCTRL  &kp LSHFT  &kp Z     &kp X         &kp C         &kp V                     &kp B      &trans           &mwh SCROLL_DOWN  &trans                 &trans                &trans              &trans      &bootloader
                                &kp LEFT_ALT  &kp LEFT_WIN  &tog 3                    &kp SPACE  &mkp LCLK        &mkp RCLK         &trans                 &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
