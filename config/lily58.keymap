#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

/{
    macros {
        strong: strong {
            compatible = "zmk,behavior-macro";
            label = "new_macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp H &kp LS(I) &kp DLLR &kp LS(V) &kp N3 &kp R &kp LS(Y) &kp DLLR &kp T &kp LS(R) &kp N0 &kp N &kp LS(G)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "Base";
            bindings = <
            &kp ESC     &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                        &kp N6    &kp N7     &kp N8     &kp N9   &kp N0   &kp BSPC
            &kp TAB     &kp Q   &kp W   &kp E     &kp R     &kp T                         &kp Y     &kp U      &kp I      &kp O    &kp P    &kp LBKT
            &kp LCTRL   &kp A   &kp S   &kp D     &kp F     &kp G                         &kp H     &kp J      &kp K      &kp L    &kp SEMI &kp SQT
            &kp LSHFT   &kp Z   &kp X   &kp C     &kp V     &kp B    &tog 3   &kp MINUS   &kp N     &kp M      &kp COMMA  &kp DOT  &kp FSLH &kp RBKT
                                        &kp LGUI  &kp LALT  &mo 1    &kp RET  &kp SPACE   &mo 2     &kp EQUAL  &tog 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        left_layer {
            label = "Left";
            bindings = <
            &kp GRAVE       &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_PRV   &bt BT_NXT    &bt BT_CLR                        &strong          &strong    &none     &none     &none     &kp DEL
            &none           &none         &none         &none        &none         &none                             &kp PAUSE_BREAK  &kp HOME   &kp UP    &kp END   &trans    &trans
            &kp CAPS        &kp K_UNDO    &kp C_PREV    &kp C_NEXT   &kp C_VOL_UP  &kp K_COPY                        &kp CARET        &kp LEFT   &kp DOWN  &kp RIGHT &kp RPAR  &kp BSLH
            &kp LEFT_SHIFT  &kp K_CUT     &kp K_MUTE    &kp C_PAUSE  &kp C_VOL_DN  &kp K_PASTE  &kp LEFT_WIN  &trans &trans           &kp MINUS  &kp EQUAL &kp LBRC  &kp RBRC  &trans
                                                        &trans       &trans        &trans       &trans        &trans &trans           &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        right_layer {
            label = "Right";
            bindings = <
            &kp F12     &kp F1      &kp F2          &kp F3         &kp F4         &kp F5                    &kp F6          &kp F7      &kp F8      &kp F9      &kp F10   &kp F11
            &kp GRAVE   &kp N1      &kp N2          &kp N3         &kp N4         &kp N5                    &kp PAUSE_BREAK &kp HOME    &kp UP      &kp END     &kp N0    &trans
            &kp LCTRL   &kp C_PREV  &kp C_NEXT      &kp PAGE_UP    &kp C_VOL_UP   &kp F6                    &strong         &kp LEFT    &kp DOWN    &kp RIGHT   &trans    &kp BSLH
            &kp LSHFT   &kp C_STOP  &kp C_PAUSE     &kp PAGE_DOWN  &kp C_VOL_DN   &kp F12  &trans  &trans   &kp KP_PLUS     &kp MINUS   &kp EQUAL   &kp KP_PLUS &kp LBRC  &kp RBRC
                                                            &trans &trans         &trans   &trans  &trans   &trans          &trans      &bootloader
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        game_layer {
            label = "Game";
            bindings = <
            &kp ESC             &kp NUMBER_5    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4                    &kp F1            &kp F2         &kp F3          &kp F4           &kp F5  &kp F6
            &kp T               &kp TAB         &kp Q         &kp W         &kp E         &kp R                           &trans            &mkp LCLK      &mmv MOVE_UP    &mkp RCLK        &trans  &trans
            &kp G               &kp CAPSLOCK    &kp A         &kp S         &kp D         &kp F                           &mwh SCROLL_UP    &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans
            &kp LEFT_CONTROL    &kp LEFT_SHIFT  &kp Z         &kp X         &kp C         &kp V     &kp B      &trans     &mwh SCROLL_DOWN  &trans         &trans          &trans           &trans  &trans
                                                              &kp LEFT_ALT  &kp LEFT_WIN  &tog 3    &kp SPACE  &mkp LCLK  &mkp RCLK         &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
